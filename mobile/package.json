{
  "name": "rospit-mobile",
  "version": "1.1.0",
  "private": true,
  "description": "РосПит: обёртка PWA в Capacitor для Android (APK) и iOS (TestFlight)",
  "scripts": {
    "sync": "cap sync",
    "android:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "assets": "capacitor-assets generate --iconBackgroundColor '#1f5bff' --splashBackgroundColor '#0a0a0c'"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "typescript": "5.6.3"
  }
}
