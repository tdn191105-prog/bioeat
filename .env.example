# Скопируйте в .env и при необходимости поменяйте значения
DATABASE_URL=postgresql+asyncpg://bioeat:bioeat@db:5432/bioeat
SECRET_KEY=change-me-to-a-long-random-string
TZ_OFFSET_HOURS=3
LOYALTY_PERCENT=5
DEMO_PAYMENTS=true
ACCESS_TOKEN_TTL_MINUTES=20160
DEFAULT_ORDER_CUTOFF_MINUTES=60
UNPAID_ORDER_TTL_MINUTES=15

# Оплата: demo | yookassa | cloudpayments | bank (пусто — по DEMO_PAYMENTS)
PAYMENT_PROVIDER=demo
# ЮKassa — ключи из личного кабинета, НЕ коммитить
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Публичный HTTPS-адрес: сюда банк вернёт студента, сюда же приходят вебхуки
PUBLIC_BASE_URL=
# Чек 54-ФЗ: 1 — без НДС, 11 — НДС 22 % (решает бухгалтерия столовой)
RECEIPT_VAT_CODE=1
RECEIPT_PAYMENT_SUBJECT=commodity
